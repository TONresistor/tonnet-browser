{
  "name": "ton-browser",
  "version": "2.6.0",
  "description": "Browse tonsites on The Open Network, Privately.",
  "homepage": "https://tonnet.resistance.dog",
  "bugs": {
    "url": "https://github.com/TONresistor/Tonnet-Browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TONresistor/Tonnet-Browser.git"
  },
  "main": "./out/main/index.js",
  "author": {
    "name": "Digital Resistance",
    "email": "tonresistor@users.noreply.github.com",
    "url": "https://resistance.dog"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint src \"scripts/*.mjs\" electron.vite.config.ts vitest.config.ts",
    "lint:fix": "eslint src \"scripts/*.mjs\" electron.vite.config.ts vitest.config.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"scripts/*.{mjs,json}\" architecture.config.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"scripts/*.{mjs,json}\" architecture.config.json",
    "architecture": "node scripts/check-architecture.mjs",
    "verify:theme-tokens": "node scripts/check-theme-tokens.mjs",
    "verify:release-metadata": "node scripts/verify-release-metadata.mjs",
    "generate:sbom": "npm sbom --sbom-format cyclonedx",
    "generate:provenance": "node scripts/generate-build-provenance.mjs",
    "type-check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:browser-runtime": "node scripts/verify-browser-runtime.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky",
    "build:binaries": "bash scripts/build-binaries-from-source.sh",
    "build:binaries:linux": "npm run build:binaries:linux:x64",
    "build:binaries:linux:x64": "bash scripts/build-binaries-from-source.sh linux amd64",
    "build:binaries:linux:arm64": "bash scripts/build-binaries-from-source.sh linux arm64",
    "build:binaries:win": "bash scripts/build-binaries-from-source.sh win",
    "build:binaries:mac": "bash scripts/build-binaries-from-source.sh mac",
    "verify:binaries": "node scripts/verify-binaries.mjs",
    "verify:binaries:linux": "npm run verify:binaries:linux:x64",
    "verify:binaries:linux:x64": "node scripts/verify-binaries.mjs linux x64",
    "verify:binaries:linux:arm64": "node scripts/verify-binaries.mjs linux arm64",
    "verify:binaries:win": "node scripts/verify-binaries.mjs win x64",
    "verify:binaries:mac": "node scripts/verify-binaries.mjs mac",
    "build:unpack": "npm run build:binaries && npm run verify:binaries && npm run build && electron-builder --dir",
    "build:linux": "npm run build:linux:x64",
    "build:linux:x64": "npm run build:binaries:linux:x64 && npm run verify:binaries:linux:x64 && npm run build && electron-builder --linux --x64",
    "build:linux:arm64": "npm run build:binaries:linux:arm64 && npm run verify:binaries:linux:arm64 && npm run build && electron-builder --linux --arm64",
    "build:win": "npm run build:binaries:win && npm run verify:binaries:win && npm run build && electron-builder --win",
    "build:mac": "npm run build:binaries:mac && npm run verify:binaries:mac && npm run build && electron-builder --mac",
    "clean": "rimraf out dist release",
    "validate": "npm run architecture && npm run verify:theme-tokens && npm run type-check && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "16.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "i18next": "^26.0.8",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.8.0",
    "punycode": "2.3.1",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "17.0.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "@ton/ton": {
      "axios": ">=1.16.0"
    }
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
